#include <iostream>

int main() {
    char let;
    std::cout<<"Enter let (A, B, C, D, E, F): " << std::endl;
    std::cin >> let;
    switch (let)
    {
    case 'A':
    case 'a':
        std::cout<<"Your rating: 5"<<std::endl;
        break;
    case 'B':
    case 'b':
        std::cout<<"Your rating: 4+" << std::endl;
        break;
    case 'C':
    case 'c':
        std::cout<<"Your rating: 4" << std::endl;
        break;
    case 'D':
    case 'd':
        std::cout<<"Your rating: 3+" << std::endl;
        break;
    case 'E':
    case 'e':
        std::cout<<"Your rating: 3" << std::endl;
        break;
    case 'F':
    case 'f':
        std::cout<<"Your rating: 2" << std::endl;
        break;
    default:
        std::cout<<"Enter correct letter!" << std::endl;
        break;
    }
    return 0;
}
