#include <iostream>

int main() {
    int a, b, c;
    std::cout<<"Enter a num: " << std::endl;
    std::cin >> a;
    std::cout<<"Enter b num: " << std::endl;
    std::cin >> b;
    std::cout<<"Enter c num: " << std::endl;
    std::cin >> c;
    if(a == b && a == c) {
        std::cout<<a<<std::endl;
        std::cout<<b<<std::endl;
        std::cout<<c<<std::endl;
        return 0;
    }
    if(a <= b && a <= c) {
        std::cout<<a<<std::endl;
        if(b <= c) {
            std::cout<<b<<std::endl;
            std::cout<<c<<std::endl;
            return 0;
        }
        std::cout<<c<<std::endl;
        std::cout<<b<<std::endl;
        return 0;
    }
    if(b <= a && b <= c) {
        std::cout<<b<<std::endl;
        if(a <= c) {
            std::cout<<a<<std::endl;
            std::cout<<c<<std::endl;
            return 0;
        }
        std::cout<<c<<std::endl;
        std::cout<<a<<std::endl;
        return 0;
    }
    if(c <= a && c <= b) {
        std::cout<<c<<std::endl;
        if(a <= b) {
            std::cout<<a<<std::endl;
            std::cout<<b<<std::endl;
            return 0;
        }
        std::cout<<b<<std::endl;
        std::cout<<a<<std::endl;
    }
    return 0;
}
