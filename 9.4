#include <iostream>

int main() {
    int num;
    std::cout<<"Enter num (1 - 3): " << std::endl;
    std::cin >> num;
    switch (num)
    {
    case 1:
        std::cout<<"S = 1/2*a*h"<<std::endl;
        break;
    case 2:
        std::cout<<"S = a * a" << std::endl;
        break;
    case 3:
        std::cout<<"S = pi*r²";
        break;
    default:
        std::cout<<"Enter correct num!";
        break;
    }
    return 0;
}
