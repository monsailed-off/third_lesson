#include <iostream>

int main() {
    int a, b, c, d;
    while (true){
    std::cout << "Enter the numerator of the first fraction: " << std::endl;
    std::cin >> a;
    std::cout << "Enter the denominator of the first fraction: " << std::endl;
    std::cin >> b;
    std::cout << "Enter the numerator of the second fraction: " << std::endl;
    std::cin >> c;
    std::cout << "Enter the denominator of the second fraction: " << std::endl;
    std::cin >> d;
    if(b == 0 || d == 0) {
        std::cout << "Error!" << std::endl;
        continue;
    } else {
        if(a * d > c * b) {
            std::cout << "First fraction is longer!" << std::endl;
            break;
        } else if(a * d < c * b) {
            std::cout << "Second fraction is longer!" << std::endl;
            break;
        } else {
            std::cout << "equal to" << std::endl;
            break;
        }
    }
    }
    return 0;
}
